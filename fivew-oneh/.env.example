# All variables are optional. The app works fully offline with bundled data.

# Serve the app from a sub-path, e.g. /fivew-oneh/ (default "/").
VITE_BASE=/

# Optional live weather. Set to "open-meteo" to fetch current conditions from
# https://open-meteo.com (no API key required). Leave empty to show only
# general regional/seasonal guidance (clearly labelled as non-live).
VITE_WEATHER_PROVIDER=

# Never put secrets in VITE_* variables: they are embedded in the client bundle.
