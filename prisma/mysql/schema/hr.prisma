model ExitChecklistItem {
  id          String    @id @default(cuid())
  exitCaseId  String
  code        String
  label       String @db.Text
  done        Boolean   @default(false)
  doneAt      DateTime?
  doneById    String? @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
