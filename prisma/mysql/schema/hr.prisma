  terminationDate   String? @db.Text
  notes             String   @default("") @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String? @db.Text
  updatedById       String? @db.Text

  entries ArticleshipNote[]
