  relievingLetterDocId  String? @db.Text
  experienceLetterDocId String? @db.Text
  instituteClosureNote  String   @default("") @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdById           String? @db.Text
  updatedById           String? @db.Text

