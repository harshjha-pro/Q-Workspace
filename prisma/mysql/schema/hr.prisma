  updatedAt     DateTime @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text

  acknowledgments PolicyAcknowledgment[]
}

model PolicyAcknowledgment {
  id             String   @id @default(cuid())
  policyId       String
  userId         String
  acknowledgedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String? @db.Text
  updatedById    String? @db.Text

  policy PolicyDocument @relation(fields: [policyId], references: [id])

  @@unique([policyId, userId])
}

model ArticleshipRecord {
  id                String   @id @default(cuid())
  userId            String   @unique
  institute         String   @default("ICAI") @db.Text // ICAI | ICSI
  registrationNo    String @db.Text
  principalId       String @db.Text
  startDate         String @db.Text
  expectedEndDate   String @db.Text
  revisedEndDate    String? @db.Text
  leaveEntitledDays Int      @default(0)
