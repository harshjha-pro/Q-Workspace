}

model HRLetter {
  id                String    @id @default(cuid())
  userId            String
  kind              String @db.Text // OFFER | APPOINTMENT | CONFIRMATION | INCREMENT | EXPERIENCE | RELIEVING
  templateVersionId String? @db.Text
  documentId        String? @db.Text
  issuedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String? @db.Text
  updatedById       String? @db.Text

  @@index([userId])
}
