  userId                String   @unique
  resignationDate       String @db.Text
  lastWorkingDate       String? @db.Text
  noticeDays            Int      @default(0)
  status                String   @default("NOTICE") @db.Text // NOTICE | HANDOVER | FNF | CLOSED
