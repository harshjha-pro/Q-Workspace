// ---------------------------------------------------------------------------
// Compliance calendar engine + Due-Date Master (Rules Spec)
// Every statutory value here is data with source / effectiveFrom / verifiedBy.
// ---------------------------------------------------------------------------

model StageTemplateFamily {
  id                    String   @id @default(cuid())
  code                  String   @unique // F1..F6
  name                  String @db.Text
  stageTemplateCode     String @db.Text
  checklistTemplateCode String? @db.Text
  reviewLevel           String   @default("MANAGER") @db.Text
  requiresSignoff       Boolean  @default(false)
  requiresUdin          Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdById           String? @db.Text
  updatedById           String? @db.Text
}

model ComplianceType {
  id                   String   @id @default(cuid())
  code                 String   @unique // GST-3B-M, TDS-26Q, PT-STATE ...
  name                 String @db.Text
  shortName            String @db.Text
  frequency            String @db.Text // MONTHLY | QUARTERLY | HALF_YEARLY | ANNUAL | EVENT | ONE_TIME
  periodBasis          String @db.Text // MONTH | FY_QUARTER | FY_HALF | FY | AY | EVENT | MANUAL
  partyBasis           String   @default("CLIENT") @db.Text // CLIENT | GSTIN | DIRECTOR | PT_STATE
  familyCode           String @db.Text
  serviceLine          String @db.Text
  ackType              String   @default("ARN") @db.Text
  weekendHolidayPolicy String   @default("NONE") @db.Text // NONE | NEXT_WORKING_DAY | PREV_WORKING_DAY
  eventTypeCode        String? @db.Text
  appliesWhen          String   @default("") @db.Text // plain-language label (P2-23)
  isFirmOnly           Boolean  @default(false)
  isClosure            Boolean  @default(false)
  active               Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdById          String? @db.Text
  updatedById          String? @db.Text

  rules        DueDateRule[]
  lateFeeRates LateFeeRate[]
}

model DueDateRule {
  id                 String    @id @default(cuid())
  complianceTypeCode String
  version            Int
  kind               String @db.Text // DAY_OF_FOLLOWING_MONTH | FIXED_DATE_AFTER_PERIOD | QUARTER_TABLE | HALF_YEAR_TABLE | EVENT_OFFSET | STATE_GROUP_TABLE | STATE_TABLE | MANUAL
  paramsJson         String @db.Text // validated per kind by the engine
  effectiveFrom      String @db.Text
  effectiveTo        String? @db.Text
  status             String    @default("ACTIVE") @db.Text // DRAFT | ACTIVE | RETIRED
  source             String    @default("") @db.Text
  notificationRef    String    @default("") @db.Text
  knowledgeArticleId String? @db.Text
  verifiedById       String? @db.Text
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String? @db.Text
  updatedById        String? @db.Text

  complianceType ComplianceType @relation(fields: [complianceTypeCode], references: [code])

  @@unique([complianceTypeCode, version])
}

model LateFeeRate {
  id                 String    @id @default(cuid())
  complianceTypeCode String
  perDayPaise        Int       @default(0)
  maxPaise           Int?
  interestBpPerMonth Int       @default(0) // basis points per month on tax due
  note               String    @default("") @db.Text
  effectiveFrom      String
  effectiveTo        String? @db.Text
  source             String    @default("") @db.Text
  verifiedById       String? @db.Text
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String? @db.Text
  updatedById        String? @db.Text

  complianceType ComplianceType @relation(fields: [complianceTypeCode], references: [code])

  @@index([complianceTypeCode, effectiveFrom])
}

model ApplicabilityFlag {
  id          String   @id @default(cuid())
  code        String   @unique // tdsApplicable, gstin.frequency ...
  label       String @db.Text
  appliesWhen String   @default("") @db.Text
  scope       String   @default("CLIENT") @db.Text // CLIENT | GSTIN | DIRECTOR | PT_STATE
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text
}

/// Rules Spec 1.2 mapping rows (condition JSON evaluated by the engine).
model ApplicabilityRule {
  id                 String   @id @default(cuid())
  complianceTypeCode String
  conditionJson      String @db.Text
  description        String   @default("") @db.Text
  effectiveFrom      String @db.Text
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String? @db.Text
  updatedById        String? @db.Text

  @@index([complianceTypeCode])
}

model EventType {
  id          String   @id @default(cuid())
  code        String   @unique // AGM | AUDITOR_APPOINTMENT | INCORPORATION | NOTICE_RECEIVED | DIRECTOR_APPOINTMENT | DIRECTOR_RESIGNATION | GST_CANCELLATION
  name        String @db.Text
  description String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text
}

model EventDate {
  id            String   @id @default(cuid())
  clientId      String
  eventTypeCode String
  periodKey     String   @default("-") // e.g. FY2026-27 for the AGM of that FY
  partyKey      String   @default("-")
  dateValue     String @db.Text
  isProvisional Boolean  @default(false)
  source        String   @default("MANUAL") @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, eventTypeCode, periodKey, partyKey])
}

/// Start/stop of each (client, compliance type, party) pair. Generation never
/// creates periods before startDate (Rules Spec 3.3) or after endDate (7.2).
model ClientComplianceSubscription {
  id                 String   @id @default(cuid())
  clientId           String
  complianceTypeCode String
  partyKey           String   @default("-")
  startDate          String @db.Text
  endDate            String? @db.Text
  endReason          String? @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String? @db.Text
  updatedById        String? @db.Text

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, complianceTypeCode, partyKey])
}

model Extension {
  id                  String    @id @default(cuid())
  status              String    @default("DRAFT") @db.Text // DRAFT | PUBLISHED | SUPERSEDED
  periodsMode         String    @default("SPECIFIC") @db.Text // SPECIFIC | ALL_OPEN
  periodKeys          String    @default("") @db.Text // comma-separated
  scopeAllClients     Boolean   @default(true)
  newEffectiveDueDate String @db.Text
  reason              String @db.Text
  notificationRef     String    @default("") @db.Text
  supersedesId        String? @db.Text
  previewCount        Int?
  publishedAt         DateTime?
  publishedById       String? @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String? @db.Text
  updatedById         String? @db.Text

  types  ExtensionType[]
  scopes ExtensionScope[]
}

model ExtensionType {
  id                 String   @id @default(cuid())
  extensionId        String
  complianceTypeCode String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String? @db.Text
  updatedById        String? @db.Text

  extension Extension @relation(fields: [extensionId], references: [id])

  @@unique([extensionId, complianceTypeCode])
}

/// One clause of a scope filter, e.g. field=state values=MH,GJ. Clauses are ANDed; values ORed.
model ExtensionScope {
  id          String   @id @default(cuid())
  extensionId String
  field       String @db.Text // constitution | gstFrequency | state | turnoverSlab | clientId
  valuesCsv   String @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  extension Extension @relation(fields: [extensionId], references: [id])
}

model Holiday {
  id          String   @id @default(cuid())
  date        String
  name        String @db.Text
  kind        String   @default("NATIONAL") @db.Text // NATIONAL | STATE | FIRM
  stateCode   String   @default("-")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  @@unique([date, stateCode])
}

/// QRMP GSTR-3B due-day grouping per state (22nd / 24th). Data, verify before go-live.
model GstStateGroup {
  id            String    @id @default(cuid())
  stateCode     String
  groupCode     String @db.Text // A | B
  effectiveFrom String
  source        String    @default("") @db.Text
  verifiedById  String? @db.Text
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text

  @@unique([stateCode, effectiveFrom])
}

// ---------------------------------------------------------------------------
// Review and sign-off
// ---------------------------------------------------------------------------

model ReviewRequest {
  id          String    @id @default(cuid())
  taskId      String
  stageIndex  Int
  level       String @db.Text // SENIOR | MANAGER | PARTNER | EQR
  makerId     String @db.Text
  checkerId   String?
  status      String    @default("PENDING") // PENDING | APPROVED | RETURNED | CANCELLED
  submittedAt DateTime  @default(now())
  decidedAt   DateTime?
  note        String    @default("") @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  points ReviewPoint[]

  @@index([taskId])
  @@index([checkerId, status])
}

model ReviewPoint {
  id              String    @id @default(cuid())
  taskId          String
  reviewRequestId String?
  text            String @db.Text
  raisedById      String @db.Text
  raisedAt        DateTime  @default(now())
  status          String    @default("OPEN") // OPEN | CLEARED
  response        String    @default("") @db.Text
  clearedById     String? @db.Text
  clearedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String? @db.Text
  updatedById     String? @db.Text

  reviewRequest ReviewRequest? @relation(fields: [reviewRequestId], references: [id])

  @@index([taskId, status])
}

model SignOff {
  id           String   @id @default(cuid())
  taskId       String?
  engagementId String?
  level        String @db.Text // CHECKER | PARTNER | EQR
  signedById   String @db.Text
  signedAt     DateTime @default(now())
  udinRecordId String? @db.Text
  note         String   @default("") @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  @@index([taskId])
  @@index([engagementId])
}

// ---------------------------------------------------------------------------
// Pending from client: checklists, pending records, reminder log
// ---------------------------------------------------------------------------

model ChecklistTemplate {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String @db.Text
  engagementType     String? @db.Text
  complianceTypeCode String? @db.Text
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String? @db.Text
  updatedById        String? @db.Text

  items ChecklistTemplateItem[]
}

model ChecklistTemplateItem {
  id          String   @id @default(cuid())
  templateId  String
  label       String @db.Text
  sortOrder   Int      @default(0)
  required    Boolean  @default(true)
  keywords    String   @default("") @db.Text // for rule-based upload tagging (Phase 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  template ChecklistTemplate @relation(fields: [templateId], references: [id])
}

model ChecklistItem {
  id                     String    @id @default(cuid())
  clientId               String
  engagementId           String?
  taskId                 String?
  label                  String @db.Text
  status                 String    @default("NOT_REQUESTED") @db.Text // NOT_REQUESTED | REQUESTED | RECEIVED | NOT_APPLICABLE
  requestedAt            String? @db.Text
  receivedAt             String? @db.Text
  receivedPendingConfirm Boolean   @default(false) // portal upload awaiting staff confirmation
  confirmedById          String? @db.Text
  confirmedAt            DateTime?
  note                   String    @default("") @db.Text
  sortOrder              Int       @default(0)
  keywords               String    @default("") @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  createdById            String? @db.Text
  updatedById            String? @db.Text

  @@index([taskId])
  @@index([engagementId])
  @@index([clientId])
}

model PendingRecord {
  id            String    @id @default(cuid())
  taskId        String
  what          String @db.Text
  since         String @db.Text
  clearedAt     DateTime?
  clearedById   String? @db.Text
  clearedReason String? @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text

  items PendingRecordItem[]

  @@index([taskId])
}

model PendingRecordItem {
  id              String   @id @default(cuid())
  pendingRecordId String
  checklistItemId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String? @db.Text
  updatedById     String? @db.Text

  pendingRecord PendingRecord @relation(fields: [pendingRecordId], references: [id])

  @@unique([pendingRecordId, checklistItemId])
}

model ReminderLog {
  id              String   @id @default(cuid())
  clientId        String?
  taskId          String?
  pendingRecordId String? @db.Text
  invoiceId       String?
  kind            String @db.Text // CLIENT_DOCS | PAYMENT | TASK_RULE | FOLLOW_UP
  channel         String @db.Text // CALL | EMAIL | WHATSAPP | IN_APP | PORTAL | MEETING
  messageText     String   @default("") @db.Text
  ruleCode        String? @db.Text
  sentAt          DateTime @default(now())
  sentById        String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String? @db.Text
  updatedById     String? @db.Text

  @@index([clientId])
  @@index([taskId])
  @@index([invoiceId])
}

model ClientReminderSchedule {
  id                 String   @id @default(cuid())
  name               String @db.Text
  complianceTypeCode String? @db.Text
  dayOfMonth         Int
  monthsCsv          String   @default("") @db.Text // empty = every month
  templateCode       String? @db.Text
  messageText        String   @default("") @db.Text
  escalateAfter      Int      @default(3)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String? @db.Text
  updatedById        String? @db.Text
}

/// "Reminder due" list item with ready-to-copy text (brief §4, P4-03 / P4-08).
model ClientReminderDue {
  id            String    @id @default(cuid())
  scheduleId    String? @db.Text
  clientId      String
  taskId        String? @db.Text
  invoiceId     String? @db.Text
  kind          String @db.Text // CLIENT_DOCS | PAYMENT
  dueOn         String
  messageText   String @db.Text
  channel       String    @default("WHATSAPP") @db.Text
  status        String    @default("DUE") // DUE | SENT | SKIPPED
  sentAt        DateTime?
  sentById      String? @db.Text
  reminderLogId String? @db.Text
  sequenceNo    Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text

  @@index([status, dueOn])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Registers: notices, DSC, UDIN, credentials vault, inward/outward
// ---------------------------------------------------------------------------

model Notice {
  id              String    @id @default(cuid())
  clientId        String
  authority       String @db.Text // INCOME_TAX | GST | TDS_TRACES | MCA_ROC | OTHER
  ayOrPeriod      String    @default("") @db.Text
  noticeType      String    @default("") @db.Text
  section         String    @default("") @db.Text
  referenceNo     String    @default("") @db.Text // DIN / reference
  noticeDate      String? @db.Text
  receivedDate    String @db.Text
  responseDueDate String?
  assigneeId      String? @db.Text
  reviewerId      String? @db.Text
  engagementId    String? @db.Text
  taskId          String? @db.Text
  status          String    @default("OPEN") @db.Text // OPEN | RESPONDED | HEARING | CLOSED
  outcome         String    @default("") @db.Text
  demandPaise     Int       @default(0)
  demandStatus    String    @default("NONE") @db.Text // NONE | RAISED | DROPPED | REDUCED | PAID
  summary         String    @default("") @db.Text
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String? @db.Text
  updatedById     String? @db.Text

  hearings Hearing[]

  @@index([clientId])
  @@index([responseDueDate])
}

model Hearing {
  id          String   @id @default(cuid())
  noticeId    String
  date        String @db.Text
  kind        String   @default("HEARING") @db.Text // HEARING | ADJOURNMENT
  notes       String   @default("") @db.Text
  outcome     String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  notice Notice @relation(fields: [noticeId], references: [id])
}

model DSC {
  id              String   @id @default(cuid())
  holderName      String @db.Text
  holderType      String   @default("DIRECTOR") @db.Text // DIRECTOR | PARTNER | INDIVIDUAL | AUTHORISED_SIGNATORY
  directorId      String? @db.Text
  dscClass        String   @default("CLASS_3") @db.Text
  dscType         String   @default("SIGNING") @db.Text // SIGNING | ENCRYPTION | COMBO
  issuer          String   @default("") @db.Text
  tokenSerial     String   @default("") @db.Text
  issueDate       String? @db.Text
  expiryDate      String
  custody         String   @default("OFFICE") @db.Text // OFFICE | CLIENT | STAFF
  location        String   @default("") @db.Text
  custodianUserId String? @db.Text
  active          Boolean  @default(true)
  notes           String   @default("") @db.Text // never a PIN (spec 6.3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String? @db.Text
  updatedById     String? @db.Text

  clients   DSCClient[]
  movements DSCMovement[]

  @@index([expiryDate])
}

model DSCClient {
  id          String   @id @default(cuid())
  dscId       String
  clientId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  dsc DSC @relation(fields: [dscId], references: [id])

  @@unique([dscId, clientId])
}

model DSCMovement {
  id          String   @id @default(cuid())
  dscId       String
  fromCustody String @db.Text
  toCustody   String @db.Text
  location    String   @default("") @db.Text
  userId      String? @db.Text
  clientId    String? @db.Text
  movedAt     DateTime @default(now())
  note        String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  dsc DSC @relation(fields: [dscId], references: [id])

  @@index([dscId])
}

model UDINRecord {
  id               String    @id @default(cuid())
  clientId         String
  engagementId     String? @db.Text
  taskId           String? @db.Text
  documentType     String @db.Text
  signingDate      String @db.Text
  partnerId        String @db.Text
  udin             String?   @unique
  generatedOn      String? @db.Text
  signedDocumentId String? @db.Text
  status           String    @default("AWAITING") // AWAITING | GENERATED | REVOKED
  reconciledAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String? @db.Text
  updatedById      String? @db.Text

  @@index([clientId])
  @@index([status])
}

model Credential {
  id                 String   @id @default(cuid())
  clientId           String
  portal             String @db.Text // INCOME_TAX | GST | TRACES | MCA | EPFO | ESIC | PT | OTHER
  label              String   @default("") @db.Text
  usernameEnc        String @db.Text
  passwordEnc        String @db.Text
  extraEnc           String? @db.Text
  changePeriodically Boolean  @default(false)
  lastChangedOn      String? @db.Text
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String? @db.Text
  updatedById        String? @db.Text

  grants   CredentialGrant[]
  viewLogs CredentialViewLog[]

  @@index([clientId])
}

model CredentialGrant {
  id            String    @id @default(cuid())
  credentialId  String?
  clientId      String
  userId        String
  grantedById   String @db.Text
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String? @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text

  credential Credential? @relation(fields: [credentialId], references: [id])

  @@index([userId])
  @@index([clientId])
}

model CredentialViewLog {
  id           String   @id @default(cuid())
  credentialId String
  userId       String @db.Text
  field        String   @default("PASSWORD") @db.Text
  viewedAt     DateTime @default(now())
  ip           String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  credential Credential @relation(fields: [credentialId], references: [id])

  @@index([credentialId])
}

model InwardOutward {
  id              String    @id @default(cuid())
  clientId        String
  direction       String @db.Text // IN | OUT
  documentDesc    String @db.Text
  date            String @db.Text
  handledById     String? @db.Text
  currentLocation String    @default("") @db.Text
  custodianUserId String?
  returnedAt      DateTime?
  portalUploadId  String? @db.Text
  notes           String    @default("") @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String? @db.Text
  updatedById     String? @db.Text

  @@index([clientId])
  @@index([custodianUserId])
}
