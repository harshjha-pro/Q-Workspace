// ---------------------------------------------------------------------------
// Client portal (spec 12) — invite-link login, no OTP delivery service
// ---------------------------------------------------------------------------

model PortalUser {
  id            String    @id @default(cuid())
  name          String @db.Text
  email         String    @unique
  mobile        String? @db.Text
  passwordHash  String? @db.Text
  totpSecretEnc String? @db.Text
  totpEnabled   Boolean   @default(false)
  active        Boolean   @default(true)
  sessionEpoch  Int       @default(0)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  contactId     String? @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text

  clients  PortalUserClient[]
  invites  PortalInvite[]
  sessions UserSession[]
}

model PortalUserClient {
  id           String   @id @default(cuid())
  portalUserId String
  clientId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  portalUser PortalUser @relation(fields: [portalUserId], references: [id])

  @@unique([portalUserId, clientId])
}

model PortalInvite {
  id           String    @id @default(cuid())
  portalUserId String
  tokenHash    String    @unique // sha256 of the one-time token
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  portalUser PortalUser @relation(fields: [portalUserId], references: [id])
}

model PortalUpload {
  id              String    @id @default(cuid())
  portalUserId    String @db.Text
  clientId        String
  engagementId    String? @db.Text
  taskId          String? @db.Text
  checklistItemId String? @db.Text
  documentId      String @db.Text
  autoTag         String? @db.Text // keyword-based suggestion (Phase 4)
  confirmedById   String? @db.Text
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String? @db.Text
  updatedById     String? @db.Text

  @@index([clientId])
}

model MessageThread {
  id                String    @id @default(cuid())
  clientId          String
  engagementId      String? @db.Text
  subject           String @db.Text
  lastMessageAt     DateTime?
  firstUnansweredAt DateTime? // response-time tracking
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String? @db.Text
  updatedById       String? @db.Text

  messages     Message[]
  participants MessageThreadParticipant[]

  @@index([clientId])
}

model MessageThreadParticipant {
  id          String    @id @default(cuid())
  threadId    String
  userId      String
  removedAt   DateTime? // set at offboarding
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  thread MessageThread @relation(fields: [threadId], references: [id])

  @@unique([threadId, userId])
}

model Message {
  id                 String    @id @default(cuid())
  threadId           String
  authorUserId       String? @db.Text
  authorPortalUserId String? @db.Text
  body               String @db.Text
  documentId         String? @db.Text
  sentAt             DateTime  @default(now())
  readByClientAt     DateTime?
  readByFirmAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String? @db.Text
  updatedById        String? @db.Text

  thread MessageThread @relation(fields: [threadId], references: [id])

  @@index([threadId])
}

model ClientApproval {
  id           String   @id @default(cuid())
  taskId       String
  portalUserId String @db.Text
  decision     String @db.Text // APPROVED | REJECTED
  comment      String   @default("") @db.Text
  documentId   String? @db.Text
  decidedAt    DateTime @default(now())
  ip           String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  @@index([taskId])
}

// Phase 4 (additive, D-80): staff ask the client to approve something (a draft return, financials). The
// decision itself is a ClientApproval row; this records the open request so the portal can list it.
model ClientApprovalRequest {
  id            String    @id @default(cuid())
  clientId      String
  taskId        String
  documentId    String? @db.Text
  title         String @db.Text
  note          String    @default("") @db.Text
  status        String    @default("OPEN") // OPEN | DECIDED | WITHDRAWN
  approvalId    String? @db.Text
  requestedById String @db.Text
  requestedAt   DateTime  @default(now())
  withdrawnAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text

  @@index([clientId, status])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Documents and working papers (13.1)
// ---------------------------------------------------------------------------

model Folder {
  id           String   @id @default(cuid())
  parentId     String? @db.Text
  clientId     String?
  engagementId String?
  periodKey    String? @db.Text
  name         String @db.Text
  path         String @db.Text // human-readable path, e.g. CL-0142/EN-00031/FY2026-27
  kind         String   @default("OTHER") @db.Text // CLIENT | ENGAGEMENT | PERIOD | AUDIT_SECTION | EMPLOYEE | SYSTEM | OTHER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  documents Document[]

  @@index([clientId])
  @@index([engagementId])
}

model Document {
  id               String    @id @default(cuid())
  folderId         String?
  clientId         String?
  engagementId     String?
  taskId           String? @db.Text
  employeeUserId   String? // HR documents: visible to HR / the employee / Partner only
  name             String @db.Text
  kind             String    @default("OTHER") @db.Text
  sourceType       String    @default("UPLOAD") @db.Text // UPLOAD | PORTAL | NOTICE | UDIN | MESSAGE | GENERATED | IMPORT | BACKUP
  confidentiality  String    @default("NORMAL") @db.Text // NORMAL | FINANCIALS | NOTICE | SALARY | HR | BILLING
  tagsCsv          String    @default("") @db.Text
  sharedWithClient Boolean   @default(false)
  currentVersion   Int       @default(1)
  checkedOutById   String? @db.Text
  checkedOutAt     DateTime?
  auditSectionCode String? @db.Text
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String? @db.Text
  updatedById      String? @db.Text

  folder   Folder?           @relation(fields: [folderId], references: [id])
  versions DocumentVersion[]

  @@index([clientId])
  @@index([engagementId])
  @@index([employeeUserId])
}

model DocumentVersion {
  id                     String   @id @default(cuid())
  documentId             String
  version                Int
  storagePath            String @db.Text // relative to STORAGE_DIR
  originalName           String @db.Text
  mimeType               String @db.Text
  sizeBytes              Int
  sha256                 String @db.Text
  uploadedByPortalUserId String? @db.Text
  note                   String   @default("") @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdById            String? @db.Text
  updatedById            String? @db.Text

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
}

/// Portable full-text index (decisions D-11).
model DocumentSearchToken {
  id          String   @id @default(cuid())
  documentId  String
  token       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  @@unique([documentId, token])
  @@index([token])
}

model AuditFileSection {
  id           String   @id @default(cuid())
  engagementId String
  code         String // PLANNING | RISK | FIELDWORK | QUERIES | REPORTS
  name         String @db.Text
  required     Boolean  @default(true)
  complete     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  @@unique([engagementId, code])
}

// ---------------------------------------------------------------------------
// Quality control (13.2)
// ---------------------------------------------------------------------------

model QCChecklist {
  id            String    @id @default(cuid())
  engagementId  String
  templateCode  String @db.Text
  status        String    @default("OPEN") @db.Text // OPEN | COMPLETE
  completedById String? @db.Text
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text

  items QCChecklistItem[]

  @@index([engagementId])
}

model QCChecklistItem {
  id          String   @id @default(cuid())
  checklistId String
  label       String @db.Text
  response    String   @default("") @db.Text // YES | NO | NA
  note        String   @default("") @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  checklist QCChecklist @relation(fields: [checklistId], references: [id])
}

model IndependenceDeclaration {
  id           String   @id @default(cuid())
  engagementId String
  userId       String
  declaredAt   DateTime @default(now())
  hasConflict  Boolean  @default(false)
  note         String   @default("") @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  @@unique([engagementId, userId])
}

model QCInspection {
  id          String    @id @default(cuid())
  name        String @db.Text
  periodFrom  String @db.Text
  periodTo    String @db.Text
  inspectorId String @db.Text
  status      String    @default("OPEN") @db.Text
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  samples  QCInspectionSample[]
  findings QCFinding[]
}

model QCInspectionSample {
  id           String   @id @default(cuid())
  inspectionId String
  engagementId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  inspection QCInspection @relation(fields: [inspectionId], references: [id])

  @@unique([inspectionId, engagementId])
}

model QCFinding {
  id               String    @id @default(cuid())
  inspectionId     String
  engagementId     String? @db.Text
  finding          String @db.Text
  severity         String    @default("MEDIUM") @db.Text
  correctiveAction String    @default("") @db.Text
  ownerId          String? @db.Text
  dueDate          String? @db.Text
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String? @db.Text
  updatedById      String? @db.Text

  inspection QCInspection @relation(fields: [inspectionId], references: [id])
}

model PeerReviewPack {
  id          String   @id @default(cuid())
  periodFrom  String @db.Text
  periodTo    String @db.Text
  documentId  String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text
}

// ---------------------------------------------------------------------------
// Templates, knowledge base, comments, meetings, notifications, helpdesk, applause
// ---------------------------------------------------------------------------

model Template {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String @db.Text
  category     String @db.Text // BOARD_RESOLUTION | MEETING_NOTICE | MINUTES | CERTIFICATE | ENGAGEMENT_LETTER | REPRESENTATION_LETTER | NOTICE_REPLY | HR_LETTER | REMINDER_MESSAGE | PROPOSAL
  outputFormat String   @default("PDF") @db.Text // PDF | DOCX | TEXT
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  versions TemplateVersion[]
}

model TemplateVersion {
  id             String    @id @default(cuid())
  templateId     String
  version        Int
  body           String @db.Text
  mergeFieldsCsv String    @default("") @db.Text
  status         String    @default("DRAFT") @db.Text // DRAFT | APPROVED | RETIRED
  approvedById   String? @db.Text
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String? @db.Text
  updatedById    String? @db.Text

  template Template @relation(fields: [templateId], references: [id])

  @@unique([templateId, version])
}

model KnowledgeArticle {
  id          String    @id @default(cuid())
  title       String @db.Text
  body        String @db.Text
  kind        String @db.Text // CIRCULAR | NOTIFICATION | EXTENSION | SOP | FAQ
  serviceLine String? @db.Text
  sourceRef   String    @default("") @db.Text
  tagsCsv     String    @default("") @db.Text
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  links KnowledgeArticleLink[]
}

model KnowledgeArticleLink {
  id                 String   @id @default(cuid())
  articleId          String
  complianceTypeCode String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String? @db.Text
  updatedById        String? @db.Text

  article KnowledgeArticle @relation(fields: [articleId], references: [id])

  @@unique([articleId, complianceTypeCode])
}

model Comment {
  id          String    @id @default(cuid())
  entityType  String // TASK | ENGAGEMENT | NOTICE | LEAD
  entityId    String
  authorId    String @db.Text
  body        String @db.Text
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  mentions Mention[]

  @@index([entityType, entityId])
}

model Mention {
  id          String    @id @default(cuid())
  commentId   String
  userId      String @db.Text
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  comment Comment @relation(fields: [commentId], references: [id])
}

model Meeting {
  id              String   @id @default(cuid())
  clientId        String @db.Text
  engagementId    String? @db.Text
  title           String @db.Text
  scheduledAt     String @db.Text // YYYY-MM-DDTHH:mm IST
  durationMinutes Int      @default(60)
  location        String   @default("") @db.Text
  agenda          String   @default("") @db.Text
  notes           String   @default("") @db.Text
  organizerId     String @db.Text
  status          String   @default("SCHEDULED") @db.Text // SCHEDULED | HELD | CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String? @db.Text
  updatedById     String? @db.Text

  attendees   MeetingAttendee[]
  actionItems ActionItem[]
}

model MeetingAttendee {
  id          String   @id @default(cuid())
  meetingId   String
  userId      String? @db.Text
  contactId   String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  meeting Meeting @relation(fields: [meetingId], references: [id])
}

model ActionItem {
  id          String   @id @default(cuid())
  meetingId   String
  title       String @db.Text
  ownerId     String @db.Text
  dueDate     String? @db.Text
  taskId      String? @db.Text
  status      String   @default("OPEN") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  meeting Meeting @relation(fields: [meetingId], references: [id])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String?
  portalUserId String?
  kind         String @db.Text
  title        String @db.Text
  body         String    @default("") @db.Text
  link         String    @default("") @db.Text
  entityType   String? @db.Text
  entityId     String? @db.Text
  priority     String    @default("NORMAL") @db.Text // NORMAL | HIGH | ESCALATION
  dedupeKey    String?   @unique
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text

  @@index([userId, readAt])
  @@index([portalUserId, readAt])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  quietFrom      String? @db.Text // HH:mm
  quietTo        String? @db.Text
  browserEnabled Boolean  @default(true)
  mutedKindsCsv  String   @default("") @db.Text // escalations can never be muted
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String? @db.Text
  updatedById    String? @db.Text
}

model HelpdeskTicket {
  id              String    @id @default(cuid())
  number          Int       @unique
  raisedById      String @db.Text
  category        String @db.Text // BUG | HOW_DO_I | DATA_CORRECTION | ACCESS | HR_QUERY | OTHER
  queue           String    @default("ADMIN") // ADMIN | HR
  subject         String @db.Text
  description     String @db.Text
  screenshotDocId String? @db.Text
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  assigneeId      String? @db.Text
  resolvedAt      DateTime?
  closedAt        DateTime?
  reopenedCount   Int       @default(0)
  faqArticleId    String? @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String? @db.Text
  updatedById     String? @db.Text

  replies TicketReply[]

  @@index([status, queue])
}

model TicketReply {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String @db.Text
  body        String @db.Text
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id])
}

model Badge {
  id          String   @id @default(cuid())
  code        String   @unique // DEADLINE_HERO | CLEAN_REVIEW | CLIENT_CHAMPION | FAST_LEARNER | TEAM_PLAYER | PROBLEM_SOLVER
  name        String @db.Text
  description String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text
}

/// Immutable: no update/delete path in code (spec 7.3).
model Applause {
  id          String   @id @default(cuid())
  toUserId    String
  fromUserId  String @db.Text
  badgeCode   String? @db.Text
  message     String @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  @@index([toUserId])
}

// ---------------------------------------------------------------------------
// Retention and system
// ---------------------------------------------------------------------------

model RetentionRule {
  id           String    @id @default(cuid())
  recordType   String    @unique
  retainYears  Int?
  basis        String    @default("") @db.Text
  purgeEnabled Boolean   @default(false)
  source       String    @default("") @db.Text
  verifiedById String? @db.Text
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String? @db.Text
  updatedById  String? @db.Text
}

model PurgeRequest {
  id            String    @id @default(cuid())
  recordType    String @db.Text
  entityIdsJson String @db.Text
  count         Int
  status        String    @default("PENDING") @db.Text // PENDING | APPROVED | REJECTED | EXECUTED
  requestedById String @db.Text
  approvedById  String? @db.Text
  decidedAt     DateTime?
  executedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text
}

/// Append-only. No update/delete function exists in /server/audit.
model AuditLog {
  id                String   @id @default(cuid())
  at                DateTime @default(now())
  actorType         String   @default("USER") @db.Text // USER | PORTAL | SYSTEM
  actorUserId       String?
  actorPortalUserId String? @db.Text
  entityType        String
  entityId          String
  action            String @db.Text // CREATE | UPDATE | DELETE | STATUS | LOGIN | LOGOUT | EXPORT | IMPORT | BACKUP | RESTORE | ...
  beforeJson        String? @db.Text
  afterJson         String? @db.Text
  reason            String   @default("") @db.Text
  lockState         String? @db.Text
  ip                String? @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String? @db.Text
  updatedById       String? @db.Text

  @@index([entityType, entityId])
  @@index([actorUserId, at])
  @@index([at])
}

model SensitiveViewLog {
  id                String   @id @default(cuid())
  at                DateTime @default(now())
  actorUserId       String?
  actorPortalUserId String? @db.Text
  kind              String @db.Text // CREDENTIAL | FINANCIALS | NOTICE | SALARY | BILLING
  entityType        String
  entityId          String
  detail            String   @default("") @db.Text
  ip                String? @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String? @db.Text
  updatedById       String? @db.Text

  @@index([actorUserId, at])
  @@index([entityType, entityId])
}

model ImportJob {
  id          String    @id @default(cuid())
  kind        String @db.Text // CLIENTS | USERS | CLIENT_TEAMS | EMPLOYEES | SALARY_STRUCTURES | LEAVE_BALANCES | RECEIVABLES | LEADS
  fileName    String @db.Text
  status      String    @default("UPLOADED") @db.Text // UPLOADED | VALIDATED | APPLIED | FAILED
  totalRows   Int       @default(0)
  validRows   Int       @default(0)
  errorRows   Int       @default(0)
  summaryJson String    @default("{}") @db.Text
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  rows ImportRow[]
}

model ImportRow {
  id          String   @id @default(cuid())
  jobId       String
  rowNumber   Int
  dataJson    String @db.Text
  errorsJson  String   @default("[]") @db.Text
  status      String   @default("PENDING") @db.Text // VALID | INVALID | APPLIED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text

  job ImportJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model ExportJob {
  id          String   @id @default(cuid())
  kind        String @db.Text
  paramsJson  String   @default("{}") @db.Text
  rowCount    Int      @default(0)
  fileName    String   @default("") @db.Text
  status      String   @default("DONE") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  valueJson   String @db.Text
  description String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? @db.Text
  updatedById String? @db.Text
}

model BackupRecord {
  id                   String    @id @default(cuid())
  fileName             String    @unique
  sizeBytes            Int
  sha256               String @db.Text
  kind                 String @db.Text // AUTO | MANUAL | PRE_RESTORE
  schemaVersion        String @db.Text
  status               String    @default("OK") @db.Text // OK | RESTORE_REQUESTED | RESTORE_APPROVED | RESTORED | MISSING
  restoreRequestedById String? @db.Text
  restoreRequestedAt   DateTime?
  restoreApprovedById  String? @db.Text
  restoreApprovedAt    DateTime?
  restoredAt           DateTime?
  note                 String    @default("") @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdById          String? @db.Text
  updatedById          String? @db.Text
}

model JobRun {
  id            String    @id @default(cuid())
  jobCode       String
  trigger       String @db.Text // CRON | MANUAL | BOOT
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String    @default("RUNNING") @db.Text // RUNNING | SUCCESS | FAILED
  summaryJson   String    @default("{}") @db.Text
  error         String? @db.Text
  triggeredById String? @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String? @db.Text
  updatedById   String? @db.Text

  @@index([jobCode, startedAt])
}
