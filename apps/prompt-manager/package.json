{
  "name": "prompt-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Private Prompt & Project Manager - single-user installable PWA",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts server/vercel.ts scripts/setup.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist/server --out-extension:.js=.mjs",
    "start": "NODE_ENV=production node dist/server/server/index.mjs",
    "setup": "tsx scripts/setup.ts",
    "setup:prod": "node dist/server/scripts/setup.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:vercel": "npm run build:client && npm run build:vercel-fn",
    "build:vercel-fn": "esbuild server/vercel.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/fn/vercel.mjs --external:@node-rs/argon2 --external:better-sqlite3 --external:pdfjs-dist --external:tesseract.js \"--banner:js=import { createRequire as __cr } from 'module'; import { fileURLToPath as __fu } from 'url'; import { dirname as __dn } from 'path'; const require = __cr(import.meta.url); const __filename = __fu(import.meta.url); const __dirname = __dn(__filename);\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.11",
    "@node-rs/argon2": "^2.2.2",
    "archiver": "^8.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "file-type": "^22.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "mysql2": "^3.24.6",
    "papaparse": "^5.7.1",
    "pdfjs-dist": "^6.5.438",
    "word-extractor": "^1.0.4",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "diff": "^9.0.0",
    "dompurify": "^3.4.18",
    "esbuild": "^0.28.2",
    "idb": "^8.0.4",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.2.0"
  }
}
