# Copy to .env — `npm run setup` does this for you and generates the keys.
DATABASE_URL="file:./prisma/data/qepex.db"
STORAGE_DIR="./storage"
BACKUP_DIR="./backups"
LOG_DIR="./logs"
# 32-byte keys, base64. Losing VAULT_KEY or PII_KEY makes encrypted fields unreadable — back up .env separately.
VAULT_KEY=""
PII_KEY=""
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# DEMO_MODE=true enables "Reset demo data". Set false for real firm data.
DEMO_MODE="true"
