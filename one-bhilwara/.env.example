# One Bhilwara — environment variables. Copy to .env.local. Never commit real values.
# Only VITE_* variables reach the browser; never put secrets in a VITE_* variable.

# Data/auth backend (Supabase). Leave empty to run in local demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI assistant: URL of YOUR server-side endpoint (e.g. /api/assistant). The AI provider key
# lives only on that server (see ANTHROPIC_API_KEY below). Empty = rule-based demo assistant.
VITE_AI_ENDPOINT=

# Live weather: "open-meteo" (no key, public API) or empty for labelled demo weather.
VITE_WEATHER_PROVIDER=

# Web push public VAPID key (private key stays on the push server).
VITE_VAPID_PUBLIC_KEY=

# Payments (Razorpay/Cashfree etc.) public key id. Empty = labelled demo checkout.
VITE_PAYMENT_KEY_ID=

# Maps provider key for embedded maps. Empty = address card + external Google Maps link.
VITE_MAPS_KEY=

# ---- Server-side only (serverless functions / backend). Never prefix with VITE_. ----
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_KEY_SECRET=
VAPID_PRIVATE_KEY=
NEWS_API_KEY=
SPORTS_API_KEY=
MARKET_DATA_API_KEY=
